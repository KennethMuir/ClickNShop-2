
generator client {
  provider = "prisma-client-js"
}

datasource PostgreSQL {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ROLE-BASED ACCESS CONTROL
// ============================================

enum Role {
  VISITOR
  CUSTOMER
  ADVERTISER
  EDITOR
  ADMIN
  SUPERADMIN
}

enum Permission {
  VIEW_MERCHANTS
  CREATE_MERCHANT
  EDIT_MERCHANT
  VERIFY_MERCHANT
  ARCHIVE_MERCHANT
  VIEW_OFFERS
  CREATE_OFFER
  EDIT_OFFER
  APPROVE_OFFER
  ARCHIVE_OFFER
  VIEW_ADVERTISERS
  CREATE_ADVERTISER
  EDIT_ADVERTISER
  REVIEW_APPLICATIONS
  APPROVE_ADVERTISER
  SUSPEND_ADVERTISER
  VIEW_CAMPAIGNS
  CREATE_CAMPAIGN
  EDIT_CAMPAIGN
  APPROVE_CAMPAIGN
  SUSPEND_CAMPAIGN
  VIEW_ANALYTICS
  VIEW_INVOICES
  PAY_INVOICE
  MANAGE_USERS
  VIEW_AUDIT_LOG
  SITE_SETTINGS_EDIT
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  passwordHash  String
  role          Role      @default(VISITOR)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  refreshSessions       RefreshSession[]
  advertiserApplications AdvertiserApplication[]
  auditLogs             AuditLog[]
  clickEvents           ClickEvent[]
  conversions           Conversion[]
}

model RefreshSession {
  id        String    @id @default(uuid())
  userId    String    @unique
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// AFFILIATE CATALOGUE
// ============================================

enum MerchantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model AffiliateNetwork {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  baseUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  affiliatePrograms AffiliateProgram[]
  merchants         Merchant[]
}

model AffiliateProgram {
  id                 String   @id @default(uuid())
  networkId          String
  programName        String
  trackingParameters Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  network       AffiliateNetwork @relation(fields: [networkId], references: [id])
  affiliateLinks AffiliateLink[]
  offers        Offer[]

  @@index([networkId])
}

model AffiliateLink {
  id             String         @id @default(uuid())
  programId      String
  merchantId     String?
  merchantSlug   String
  destinationUrl String
  categoryId     String?
  status         MerchantStatus @default(ACTIVE)
  logoUrl        String?
  imageUrl       String?
  clickCount     Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  program     AffiliateProgram @relation(fields: [programId], references: [id])
  merchant    Merchant?        @relation(fields: [merchantId], references: [id])
  category    Category?        @relation(fields: [categoryId], references: [id])
  clickEvents ClickEvent[]

  @@unique([programId, merchantSlug])
  @@index([programId])
  @@index([merchantId])
  @@index([categoryId])
  @@index([status])
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchants     Merchant[]
  affiliateLinks AffiliateLink[]
  offers        Offer[]
}

model Merchant {
  id                 String        @id @default(uuid())
  name               String
  slug               String        @unique
  description        String?
  categoryId         String
  affiliateNetworkId String
  status             MerchantStatus @default(ACTIVE)
  logoUrl            String?
  imageUrl           String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  category         Category         @relation(fields: [categoryId], references: [id])
  affiliateNetwork AffiliateNetwork  @relation(fields: [affiliateNetworkId], references: [id])
  affiliateLinks   AffiliateLink[]
  offers           Offer[]
  clickEvents      ClickEvent[]
  impressionEvents ImpressionEvent[]
  conversions      Conversion[]
  commissions      AffiliateCommission[]

  @@index([categoryId])
  @@index([affiliateNetworkId])
  @@index([status])
}

// ============================================
// OFFERS AND DEALS
// ============================================

enum OfferStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  SUSPENDED
}

enum OfferFeatured {
  NO
  YES
  SCHEDULED
}

model Offer {
  id                String        @id @default(uuid())
  title             String
  slug              String        @unique
  description       String?
  merchantId        String
  categoryId        String
  affiliateProgramId String
  status            OfferStatus   @default(ACTIVE)
  featured          OfferFeatured @default(NO)
  expiryDate        DateTime?
  clickCount        Int           @default(0)
  impressionCount   Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  merchant         Merchant         @relation(fields: [merchantId], references: [id])
  category         Category         @relation(fields: [categoryId], references: [id])
  affiliateProgram AffiliateProgram @relation(fields: [affiliateProgramId], references: [id])

  clickEvents      ClickEvent[]
  impressionEvents ImpressionEvent[]
  conversions      Conversion[]
  commissions      AffiliateCommission[]

  @@index([merchantId])
  @@index([categoryId])
  @@index([affiliateProgramId])
  @@index([status])
  @@index([featured])
}

// ============================================
// ADVERTISER SYSTEM
// ============================================

enum AdvertiserStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
  APPLICATION_SUBMITTED
  APPLICATION_REVIEWED
}

enum ApplicationReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Advertiser {
  id                  String                @id @default(uuid())
  companyName         String
  contactPerson       String
  businessEmail       String                @unique
  telephone           String?
  website             String?
  businessDescription String?
  billingDetails      Json?
  verificationInfo    Json?
  status              AdvertiserStatus      @default(PENDING)
  applicationReview   ApplicationReviewStatus @default(PENDING)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  applications       AdvertiserApplication[]
  campaigns          Campaign[]
  invoices            Invoice[]
  clickEvents         ClickEvent[]
  impressionEvents    ImpressionEvent[]
  conversions         Conversion[]
  affiliateCommissions AffiliateCommission[]
}

model AdvertiserApplication {
  id          String                 @id @default(uuid())
  advertiserId String
  status      ApplicationReviewStatus @default(PENDING)
  submittedAt DateTime               @default(now())
  reviewedAt  DateTime?
  reviewerId  String?
  reviewNotes String?
  documents   Json?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  advertiser Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  reviewedBy User?      @relation(fields: [reviewerId], references: [id])

  @@index([advertiserId])
  @@index([reviewerId])
  @@index([status])
}

// ============================================
// ADVERTISING PACKAGES
// ============================================

enum PackageStatus {
  ACTIVE
  INACTIVE
  PROMOTIONAL
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

model AdvertisingPackage {
  id                   String          @id @default(uuid())
  name                 String
  description          String
  price                Decimal         @PostgreSQL.Decimal(12, 2)
  billingInterval      BillingInterval
  status               PackageStatus   @default(ACTIVE)
  placementEligibility Json?
  campaignDuration     Int?
  impressionLimit      Int?
  clickLimit           Int?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  campaigns Campaign[]
  invoices  Invoice[]
}

// ============================================
// CAMPAIGNS
// ============================================

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum CampaignObjective {
  BRAND_AWARENESS
  TRAFFIC
  CONVERSIONS
  LEAD_GENERATION
}

model Campaign {
  id               String            @id @default(uuid())
  advertiserId     String
  packageId        String
  name             String
  description      String?
  objective        CampaignObjective
  status           CampaignStatus    @default(DRAFT)
  placement        String?
  startDate        DateTime
  endDate          DateTime
  budget           Decimal           @PostgreSQL.Decimal(12, 2)
  spent            Decimal           @default(0) @PostgreSQL.Decimal(12, 2)
  impressionCount  Int               @default(0)
  clickCount       Int               @default(0)
  clickThroughRate Decimal           @default(0) @PostgreSQL.Decimal(5, 2)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  advertiser Advertiser        @relation(fields: [advertiserId], references: [id])
  package    AdvertisingPackage @relation(fields: [packageId], references: [id])

  placements       CampaignPlacement[]
  clickEvents      ClickEvent[]
  impressionEvents ImpressionEvent[]
  conversions      Conversion[]
  invoices         Invoice[]

  @@index([advertiserId])
  @@index([status])
  @@index([packageId])
  @@index([startDate, endDate])
}

// ============================================
// CAMPAIGN PLACEMENTS
// ============================================

model CampaignPlacement {
  id          String    @id @default(uuid())
  campaignId  String
  placement   String
  position    Int?
  startDate   DateTime?
  endDate     DateTime?
  impressions Int       @default(0)
  clicks      Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([placement])
}

// ============================================
// TRACKING EVENTS
// ============================================

model ClickEvent {
  id              String   @id @default(uuid())
  offerId         String?
  affiliateLinkId String?
  merchantId      String?
  campaignId      String?
  advertiserId    String?
  userId          String?
  sessionId       String?
  network         String?
  ipAddress       String?
  userAgent       String?
  deviceCategory  String?
  landingPage     String
  referralSource  String?
  timestamp       DateTime @default(now())
  affiliateParams Json?

  offer        Offer?        @relation(fields: [offerId], references: [id])
  affiliateLink AffiliateLink? @relation(fields: [affiliateLinkId], references: [id])
  merchant     Merchant?     @relation(fields: [merchantId], references: [id])
  campaign     Campaign?     @relation(fields: [campaignId], references: [id])
  advertiser   Advertiser?   @relation(fields: [advertiserId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([offerId])
  @@index([affiliateLinkId])
  @@index([merchantId])
  @@index([campaignId])
  @@index([advertiserId])
  @@index([userId])
  @@index([network])
  @@index([timestamp])
}

model ImpressionEvent {
  id             String   @id @default(uuid())
  offerId        String?
  merchantId     String?
  campaignId     String?
  advertiserId   String?
  sessionId      String
  ipAddress      String?
  userAgent      String?
  deviceCategory String?
  placement      String?
  location       String?
  timestamp      DateTime @default(now())

  offer      Offer?      @relation(fields: [offerId], references: [id])
  merchant   Merchant?   @relation(fields: [merchantId], references: [id])
  campaign   Campaign?   @relation(fields: [campaignId], references: [id])
  advertiser Advertiser? @relation(fields: [advertiserId], references: [id])

  @@index([offerId])
  @@index([merchantId])
  @@index([campaignId])
  @@index([advertiserId])
  @@index([timestamp])
}

model Conversion {
  id              String   @id @default(uuid())
  offerId         String?
  merchantId      String?
  campaignId      String?
  advertiserId    String?
  userId          String?
  sessionId       String
  type            String
  status          String
  reportedRevenue Decimal  @PostgreSQL.Decimal(12, 2)
  commissionRate  Decimal  @PostgreSQL.Decimal(8, 4)
  timestamp       DateTime @default(now())
  transactionId   String?
  affiliateParams Json?

  offer      Offer?      @relation(fields: [offerId], references: [id])
  merchant   Merchant?   @relation(fields: [merchantId], references: [id])
  campaign   Campaign?   @relation(fields: [campaignId], references: [id])
  advertiser Advertiser? @relation(fields: [advertiserId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])

  @@index([offerId])
  @@index([merchantId])
  @@index([campaignId])
  @@index([advertiserId])
  @@index([userId])
  @@index([status])
  @@index([timestamp])
}

// ============================================
// FINANCIAL - COMMISSIONS
// ============================================

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REVERSED
}

model AffiliateCommission {
  id               String           @id @default(uuid())
  offerId          String
  merchantId       String
  advertiserId     String?
  amount           Decimal          @PostgreSQL.Decimal(12, 2)
  commissionRate   Decimal          @PostgreSQL.Decimal(8, 4)
  status           CommissionStatus @default(PENDING)
  networkReference String?
  approvedAt       DateTime?
  paidAt           DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  offer      Offer       @relation(fields: [offerId], references: [id])
  merchant   Merchant    @relation(fields: [merchantId], references: [id])
  advertiser Advertiser? @relation(fields: [advertiserId], references: [id])

  @@index([offerId])
  @@index([merchantId])
  @@index([advertiserId])
  @@index([status])
}

// ============================================
// BILLING - INVOICES AND PAYMENTS
// ============================================

model Invoice {
  id                   String   @id @default(uuid())
  advertiserId         String
  campaignId           String?
  advertisingPackageId String?
  amount               Decimal  @PostgreSQL.Decimal(12, 2)
  currency             String   @default("USD")
  status               String
  invoiceNumber        String   @unique
  issueDate            DateTime @default(now())
  dueDate              DateTime
  paidDate             DateTime?
  paymentMethod        String?
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  advertiser        Advertiser         @relation(fields: [advertiserId], references: [id])
  campaign          Campaign?          @relation(fields: [campaignId], references: [id])
  advertisingPackage AdvertisingPackage? @relation(fields: [advertisingPackageId], references: [id])
  payments          Payment[]

  @@index([advertiserId])
  @@index([campaignId])
  @@index([advertisingPackageId])
  @@index([status])
}

// ============================================
// PAYMENTS
// ============================================

model Payment {
  id            String   @id @default(uuid())
  invoiceId     String
  amount        Decimal  @PostgreSQL.Decimal(12, 2)
  paymentMethod String
  transactionId String?
  status        String
  paymentDate   DateTime @default(now())
  createdAt     DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([status])
}

// ============================================
// SITE SETTINGS AND INTEGRATIONS
// ============================================

model SiteSetting {
  key       String   @id
  value     String?
  type      String
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
  isActive     Boolean  @default(true)
  source       String?
  consent      Boolean  @default(true)
}

model ContactInquiry {
  id          String   @id @default(uuid())
  name        String
  email       String
  subject     String
  message     String
  status      String
  createdAt   DateTime @default(now())
  respondedAt DateTime?

  @@index([status])
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  action        String
  resource      String
  resourceId    String?
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  timestamp     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([timestamp])
  @@index([resource])
}
