# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clicknshop?schema=public"

# Application
NODE_ENV="development"
APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"

# Authentication
BCRYPT_SALT_ROUNDS="12"
JWT_ACCESS_TOKEN_EXPIRES_IN="15m"
JWT_REFRESH_TOKEN_EXPIRES_IN="30d"
JWT_ACCESS_TOKEN_SECRET="replace-with-secure-random-value"
JWT_REFRESH_TOKEN_SECRET="replace-with-secure-random-value"

# Server
PORT="3000"
API_PORT="4000"

# External Services
YAZING_WIDGET_ID="yzwg-18124934b9951f7acef555688afa13c3"
YAZING_SCRIPT_URL="https://yazing.com/js/showdeals-yzwg.js?id=yzwg-18124934b9951f7acef555688afa13c3&d="

# File Upload
MAX_FILE_SIZE="5242880"
ALLOWED_MIME_TYPES="image/jpeg,image/png,image/webp"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX "100"

# CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:4000"